{
  "name": "Auto Commit and Push",
  "version": "1.0.0",
  "description": "After every file write, stages all changes, generates a descriptive commit message based on the diff, commits, and pushes",
  "when": {
    "type": "postToolUse",
    "toolTypes": ["write"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A file was just written or modified. Please do the following:\n1. Run `git add -A` to stage all changes\n2. Run `git diff --cached --stat` and `git diff --cached` to review what changed\n3. Write a concise, descriptive commit message that summarizes the changes (e.g. 'feat: add StopCard drag-and-drop support' or 'fix: correct itinerary slice reducer logic')\n4. Run `git commit -m \"<your message>\"`\n5. Run `git push`\n\nIf there is nothing to commit (working tree clean), skip steps 3-5."
  }
}
