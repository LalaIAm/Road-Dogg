{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "When any source file changes (JS, JSX, JSON, CSS, or Firebase/Cloud Functions), ask the agent to update the README or /docs folder to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.js",
      "src/**/*.jsx",
      "src/**/*.css",
      "src/**/*.json",
      "functions/src/**/*.js",
      "package.json",
      "firebase.json",
      ".firebaserc"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and update the documentation accordingly. If a README.md exists at the project root, update the relevant sections there. If a /docs folder exists, update the appropriate doc files inside it. Only update documentation that is directly affected by the change — don't rewrite unrelated sections."
  }
}